DATABASE_URL="postgresql://reddit:reddit@localhost:5433/reddit"
PORT=3001
NODE_ENV="development"
JWT_SECRET="dev-only-change-in-production"
JWT_EXPIRES_IN="7d"

# Web app URL (OAuth redirects, CORS)
WEB_URL="http://localhost:3000"

# Extra CORS origins (comma-separated), e.g. Vercel preview URLs
# CORS_ORIGINS="https://my-app.vercel.app,https://my-app-git-main.vercel.app"

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/google/callback"

# Magic link email — https://resend.com (free tier)
RESEND_API_KEY=""
EMAIL_FROM="onboarding@resend.dev"

# --- Production (Render) — see .env.production.example ---
# Do not put production URLs in this file; use Render dashboard.
# Vercel web: see apps/web/.env.production.example
