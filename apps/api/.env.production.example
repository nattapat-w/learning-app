# Production API env — set on RENDER (not in this file on the server).
# Copy each key to: Render Dashboard → learning-app-api → Environment
#
# For local dev use apps/api/.env (from .env.example).
# Optional: copy to apps/api/.env.production.local for local prod smoke tests
# (.env.production.local is gitignored).

NODE_ENV=production

# Render Postgres → Internal Database URL (not external)
DATABASE_URL=<paste Render internal connection string>

# New random string in production — never reuse dev JWT_SECRET
JWT_SECRET=<new random 32+ char string>
JWT_EXPIRES_IN=7d

# Your Vercel production URL (no trailing slash)
WEB_URL=https://learning-app-web-x5eh.vercel.app

# Optional: Vercel preview deploys
# CORS_ORIGINS=https://learning-app-web-git-main.vercel.app

GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
# Must match Vercel /api proxy so JWT cookie is set on your Vercel domain (not Render)
GOOGLE_CALLBACK_URL=https://learning-app-web.vercel.app/api/auth/google/callback

LINE_CHANNEL_ID=<your-line-channel-id>
LINE_CHANNEL_SECRET=<your-line-channel-secret>
LINE_CALLBACK_URL=https://learning-app-web-x5eh.vercel.app/api/auth/line/callback

RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Do NOT set PORT on Render — platform injects it
